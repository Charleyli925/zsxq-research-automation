{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZSXQ summary output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "handled_count",
    "handled_paths",
    "summaries",
    "error"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "handled_count": {
      "type": "integer"
    },
    "handled_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "filename", "title", "quality_hint", "markdown"],
        "properties": {
          "path": {"type": "string"},
          "filename": {"type": "string"},
          "title": {"type": "string"},
          "quality_hint": {"type": "string"},
          "markdown": {"type": "string"}
        }
      }
    },
    "error": {
      "type": ["string", "null"]
    }
  }
}
