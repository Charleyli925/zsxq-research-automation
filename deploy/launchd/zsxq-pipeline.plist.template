<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__RELEASE_CURRENT__/scripts/run_zsxq_pipeline.py</string>
    <string>tick</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ZSXQ_PIPELINE_RUNTIME_ROOT</key>
    <string>__RUNTIME_ROOT__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/pipeline.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/pipeline.stderr.log</string>
</dict>
</plist>
