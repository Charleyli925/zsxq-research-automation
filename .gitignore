openclaw_tasks/**/text_cache/
openclaw_tasks/**/summary_cache/
openclaw_tasks/**/state/

# Feishu caches and legacy backfill inventories are local-only data.
**/feishu_doc_cache/
**/zsxq_legacy_inventory/

# This subproject writes its own local runtime database, logs, and screenshots.
chatgpt_pdf_agent/runtime/

# Private operational notes contain machine paths and deployment identifiers.
