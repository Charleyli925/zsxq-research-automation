# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
*.egg-info/

# Local editors and operating-system files
.DS_Store
.idea/
.vscode/

# Private configuration and credentials
.env
.env.*
!.env.example
config/local/
openclaw_tasks/**/config.env
openclaw_tasks/**/config.local.env
# Generated by deploy/install_local_runtime.sh. It records the immutable
# release checkout without mixing machine-specific secrets into config.env.
openclaw_tasks/**/deployment.env

# Active job definitions contain real group/topic IDs and remain local.
/config/interest_keywords.json
/config/zsxq_domestic_cicc_keywords.json
/config/zsxq_domestic_cicc_reports_job.json
/config/zsxq_foreign_reports_job.json

# Runtime state, logs, caches, and generated output
.runtime/
logs/
state/
tmp/
output/
code-explainer-output/
.playwright-cli/
.playwright-mcp/

# Task-local runtime artifacts
openclaw_tasks/**/.run.pid
openclaw_tasks/**/cron.log
openclaw_tasks/**/launchd*.log
openclaw_tasks/**/startup_debug.log
openclaw_tasks/**/watch_state.json
openclaw_tasks/**/pending_batch.json
openclaw_tasks/**/last_*.json
openclaw_tasks/**/last_*.md
