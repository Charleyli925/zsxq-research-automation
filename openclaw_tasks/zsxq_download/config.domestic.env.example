# Copy to ${OPENCLAW_TASKS_ROOT}/ZSXQ_国内研报_中金公司/config.env.
# Keep chat identifiers and any credentials outside Git.

AUTOMATION_ROOT="/absolute/path/to/a/clean/release-checkout"
TARGET_CHAT_ID=""
ZSXQ_SOURCE_NAME="domestic_cicc"
ZSXQ_JOB_CONFIG_FILE="/absolute/path/to/zsxq_domestic_cicc_reports_job.json"
ZSXQ_KEYWORDS_FILE="/absolute/path/to/zsxq_domestic_cicc_keywords.json"
ZSXQ_LEGACY_STATE_FILE="${INVESTMENT_REPORTS_RUNTIME_DIR:-${AUTOMATION_ROOT}/.runtime}/state/zsxq_domestic_cicc_reports_state.json"
NOTIFICATION_PIPELINE="domestic_cicc"
NOTIFICATION_POLICY_PATH="${AUTOMATION_ROOT}/scripts/zsxq_notification_policy.py"

CFT_EXECUTABLE_PATH="/Applications/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
CFT_REMOTE_DEBUG_PORT="9223"
CFT_USER_DATA_DIR="${HOME}/.openclaw/browser-profiles/zsxq-cft"

LOG_FILE="cron.log"
RESULT_JSON="last_result.json"
RESULT_MD="last_result.md"
TIME_WINDOW_OVERRIDE_FILE="time_window_override.json"
LOG_MAX_BYTES="20971520"
LOG_BACKUP_COUNT="3"
PYTHON_BIN="python3"
LARK_CLI_BIN="lark-cli"

ZSXQ_PLAYWRIGHT_ACTION_TIMEOUT_SECONDS="30"
ZSXQ_NAVIGATION_ATTEMPTS="3"
