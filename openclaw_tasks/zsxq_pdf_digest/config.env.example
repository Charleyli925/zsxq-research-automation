#!/usr/bin/env bash

# Copy to config.env for a local deployment. config.env is ignored by Git.
#
# Keep chat IDs, local paths and any machine-owned preferences here.  CLI
# authentication remains in the owning Codex / lark-cli profile; do not copy
# credentials, agent homes or browser profiles into this file.
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTOMATION_ROOT="${AUTOMATION_ROOT:-$(cd "$CONFIG_DIR/../.." && pwd)}"

# Local content and scanner inputs.  The digest only reads PDFs after the
# download pipeline has archived them; it does not control download windows.
RESEARCH_LIBRARY_ROOT="${RESEARCH_LIBRARY_ROOT:-${HOME}/Library/Application Support/investment-reports-automation/ResearchLibrary}"
OBSIDIAN_VAULT_ROOT="${OBSIDIAN_VAULT_ROOT:-${HOME}/Library/Application Support/investment-reports-automation/ResearchVault}"
WATCH_ROOT="${WATCH_ROOT:-${RESEARCH_LIBRARY_ROOT}/pdfs}"
WATCH_EXTRA_ROOTS="${WATCH_EXTRA_ROOTS:-}"

# Task-local runtime names.  All values resolve beneath the cron task directory
# supplied by run.sh; these are not repository files.
PIPELINE_DATABASE="${PIPELINE_DATABASE:-state/pipeline.sqlite3}"
STATE_FILE="${STATE_FILE:-watch_state.json}"
BATCH_JSON="${BATCH_JSON:-pending_batch.json}"
RUN_STATUS_JSON="${RUN_STATUS_JSON:-run_status.json}"
RESULT_JSON="${RESULT_JSON:-last_result.json}"
RESULT_MD="${RESULT_MD:-last_result.md}"
PREFLIGHT_JSON="${PREFLIGHT_JSON:-last_preflight.json}"
QUARANTINE_JSON="${QUARANTINE_JSON:-quarantine.json}"
USAGE_JSON="${USAGE_JSON:-last_usage_summary.json}"
NOTIFICATION_JSONL="${NOTIFICATION_JSONL:-notification_messages.jsonl}"
TEXT_CACHE_DIR="${TEXT_CACHE_DIR:-text_cache}"
SUMMARY_CACHE_DIR="${SUMMARY_CACHE_DIR:-summary_cache}"
LOG_FILE="${LOG_FILE:-cron.log}"
LOG_MAX_BYTES="${LOG_MAX_BYTES:-20971520}"
LOG_BACKUP_COUNT="${LOG_BACKUP_COUNT:-3}"

# Direct, stateless summary invocation.  `codex exec` receives only extracted
# text plus the fixed prompt/schema and is started with an ephemeral,
# read-only, ignore-user-config contract by the pipeline.  填入已审批的现有
# 模型名；留空会让预检失败，而不是静默切换或升级模型。
PYTHON_BIN="${PYTHON_BIN:-python3}"
CODEX_BIN="${CODEX_BIN:-codex}"
CODEX_MODEL="${CODEX_MODEL:-}"
CODEX_REASONING="${CODEX_REASONING:-high}"
CODEX_TIMEOUT_SECONDS="${CODEX_TIMEOUT_SECONDS:-600}"
SUMMARY_WORKER_COUNT="${SUMMARY_WORKER_COUNT:-2}"

# Extraction and deterministic publication grouping.  Summary workers may run
# at most twice in parallel; Lark writes are serialized in source order.
# Must match the retained extractor's `EXTRACTOR_PROFILE`.  Bump this only
# together with an extractor contract change, so existing text artifacts never
# cross an unreviewed cache boundary.
EXTRACTOR_VERSION="${EXTRACTOR_VERSION:-ocr-geometry-v2}"
DOC_GROUP_SIZE="${DOC_GROUP_SIZE:-10}"
DOC_GROUP_THRESHOLD="${DOC_GROUP_THRESHOLD:-15}"
MAX_FILES_PER_DOCUMENT="${MAX_FILES_PER_DOCUMENT:-20}"
LOCAL_OCR_FALLBACK_ENABLE="${LOCAL_OCR_FALLBACK_ENABLE:-true}"

# Lark identity split. Documents are always created, appended, fetched and
# granted by the local user identity.  Group notifications are always sent by
# the bot identity with an idempotency key.  The existing profile directory may
# retain its historical name; it is not a runtime dependency on OpenClaw.
LARK_CLI_BIN="${LARK_CLI_BIN:-lark-cli}"
LARKSUITE_CLI_CONFIG_DIR="${LARKSUITE_CLI_CONFIG_DIR:-${HOME}/.lark-cli/openclaw}"
LARK_CLI_TIMEOUT_SECONDS="${LARK_CLI_TIMEOUT_SECONDS:-90}"
TARGET_CHAT_ID="${TARGET_CHAT_ID:-}"
LARK_CLI_NOTIFICATIONS="${LARK_CLI_NOTIFICATIONS:-true}"
PUBLISH_LARK_CLI_PARENT_POSITION="${PUBLISH_LARK_CLI_PARENT_POSITION:-my_library}"

# `QUIET_WINDOW_MINUTES` is retained for compatibility with the scheduled
# scan.  It only controls when a recently written PDF is eligible for work.
QUIET_WINDOW_MINUTES="${QUIET_WINDOW_MINUTES:-15}"
