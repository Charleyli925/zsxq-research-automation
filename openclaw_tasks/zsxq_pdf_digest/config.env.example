#!/usr/bin/env bash

# Copy to config.env for a local deployment. config.env is ignored by Git.
#
# Ownership boundary:
# - Keep business configuration, chat identifiers, and machine-local paths here.
# - In a production release, deploy/install_local_runtime.sh generates a sibling
#   deployment.env that overrides only the release-owned source paths below.
# - Do not pin a production config.env to a development checkout.
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Development-only source-path defaults. deployment.env owns these values for a
# release deployment and must not contain business configuration or credentials.
AUTOMATION_ROOT="${AUTOMATION_ROOT:-$(cd "$CONFIG_DIR/../.." && pwd)}"
SCANNER_SCRIPT_PATH="${SCANNER_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/scan_new_zsxq_pdfs.py}"
HELPER_SCRIPT_PATH="${HELPER_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/manage_zsxq_digest_batch.py}"
RESEARCH_LIBRARY_INDEX_SCRIPT_PATH="${RESEARCH_LIBRARY_INDEX_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/research_library_index.py}"
MARKITDOWN_SCRIPT_PATH="${MARKITDOWN_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/convert_with_markitdown.py}"
CLEAN_MARKDOWN_SCRIPT_PATH="${CLEAN_MARKDOWN_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/build_clean_markdown.py}"
OBSIDIAN_ARCHIVE_SCRIPT_PATH="${OBSIDIAN_ARCHIVE_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/archive_to_obsidian.py}"
OBSIDIAN_INDEX_SCRIPT_PATH="${OBSIDIAN_INDEX_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/update_obsidian_indexes.py}"
OBSIDIAN_INDEX_TIMEOUT_SECONDS="${OBSIDIAN_INDEX_TIMEOUT_SECONDS:-900}"
OBSIDIAN_INDEX_TERMINATE_GRACE_SECONDS="${OBSIDIAN_INDEX_TERMINATE_GRACE_SECONDS:-10}"
RUNTIME_GUARD_SCRIPT_PATH="${RUNTIME_GUARD_SCRIPT_PATH:-${AUTOMATION_ROOT}/scripts/zsxq_runtime_guard.py}"

# Business configuration and local data ownership.
RESEARCH_LIBRARY_ROOT="${RESEARCH_LIBRARY_ROOT:-${HOME}/Library/Application Support/investment-reports-automation/ResearchLibrary}"
OBSIDIAN_VAULT_ROOT="${OBSIDIAN_VAULT_ROOT:-${HOME}/Library/Application Support/investment-reports-automation/ResearchVault}"

TARGET_CHAT_ID="${TARGET_CHAT_ID:-}"
WATCH_ROOT="${WATCH_ROOT:-${RESEARCH_LIBRARY_ROOT}/pdfs}"
WATCH_EXTRA_ROOTS="${WATCH_EXTRA_ROOTS:-}"

DOWNLOAD_TASK_DIR="${DOWNLOAD_TASK_DIR:-${HOME}/.openclaw/workspace/tasks/ZSXQ_autodownload}"
SUMMARY_AGENT_ID="${SUMMARY_AGENT_ID:-zsxq_pdf_digest_summary}"
SUMMARY_AGENT_THINKING="${SUMMARY_AGENT_THINKING:-high}"
SUMMARY_PARALLEL_ENABLED="${SUMMARY_PARALLEL_ENABLED:-true}"
SUMMARY_WORKER_COUNT="${SUMMARY_WORKER_COUNT:-2}"
SUMMARY_WORKER_AGENT_ID_PREFIX="${SUMMARY_WORKER_AGENT_ID_PREFIX:-${SUMMARY_AGENT_ID}_w}"
SUMMARY_LOCK_STALE_SECONDS="${SUMMARY_LOCK_STALE_SECONDS:-300}"

LOG_FILE="cron.log"
LOG_MAX_BYTES="20971520"
LOG_BACKUP_COUNT="3"
STATE_FILE="watch_state.json"
BATCH_JSON="pending_batch.json"
RESULT_JSON="last_result.json"
RESULT_MD="last_result.md"
RUN_STATUS_JSON="run_status.json"
USAGE_JSON="last_usage_summary.json"
NOTIFICATION_JSONL="notification_messages.jsonl"
FAILURE_STATE_JSON="failure_backoff.json"
PREFLIGHT_JSON="last_preflight.json"
QUARANTINE_JSON="quarantine.json"
QUARANTINE_REPORT_MD="quarantine_report.md"
TEXT_CACHE_DIR="text_cache"
SUMMARY_CACHE_DIR="summary_cache"

PYTHON_BIN="${PYTHON_BIN:-python3}"
LARK_CLI_BIN="${LARK_CLI_BIN:-lark-cli}"
LARKSUITE_CLI_CONFIG_DIR="${LARKSUITE_CLI_CONFIG_DIR:-${HOME}/.lark-cli/openclaw}"
LARK_CLI_SEND_AS="${LARK_CLI_SEND_AS:-bot}"
LARK_CLI_NOTIFICATIONS="${LARK_CLI_NOTIFICATIONS:-true}"
PUBLISH_LARK_CLI_AS="${PUBLISH_LARK_CLI_AS:-user}"
PUBLISH_LARK_CLI_PARENT_POSITION="${PUBLISH_LARK_CLI_PARENT_POSITION:-my_library}"

QUIET_WINDOW_MINUTES="${QUIET_WINDOW_MINUTES:-15}"
BATCH_CHUNK_SIZE="${BATCH_CHUNK_SIZE:-1}"
DOC_GROUP_SIZE="${DOC_GROUP_SIZE:-10}"
DOC_GROUP_THRESHOLD="${DOC_GROUP_THRESHOLD:-15}"
LOCAL_OCR_FALLBACK_ENABLE="${LOCAL_OCR_FALLBACK_ENABLE:-true}"
